# Copy to .env and fill in. Never commit .env.

# Yandex Maps JavaScript API key (https://developer.tech.yandex.ru, free plan for development).
EXPO_PUBLIC_YANDEX_MAPS_KEY=

# Optional: API address. By default the app uses the laptop IP that Expo Go connected to.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
