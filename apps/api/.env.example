# Copy this file to .env and adjust if needed. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Matches docker-compose.yml (local development only).
DATABASE_URL=postgresql://usta:usta_dev_password@localhost:5432/usta
# Separate database for automated tests (tables are wiped between tests).
DATABASE_URL_TEST=postgresql://usta:usta_dev_password@localhost:5432/usta_test

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# "console" prints SMS codes in the API terminal.
SMS_PROVIDER=console

# File storage (S3-compatible). Matches docker-compose.yml + docker/seaweedfs-s3.json.
S3_ENDPOINT=http://localhost:8333
# S3_PUBLIC_ENDPOINT=http://<laptop-ip>:8333   (optional in development)
S3_REGION=us-east-1
S3_BUCKET=usta-dev
S3_ACCESS_KEY=usta_dev_access
S3_SECRET_KEY=usta_dev_secret_key

# Push notifications: "expo" (real, via Expo) or "log" (print in terminal).
PUSH_PROVIDER=expo

# Admin panel (apps/admin). Generate the secret like the ones above.
ADMIN_JWT_SECRET=change-me-to-a-third-long-random-string-32-chars
ADMIN_ORIGIN=http://localhost:5173
