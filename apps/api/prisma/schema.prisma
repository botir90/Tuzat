// Prisma schema. Models are added milestone by milestone (see CLAUDE.md section 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  MASTER
  ADMIN
}

/// Languages are stored with underscores because Prisma enum values can't contain "-".
/// The API maps them to "uz-Latn" / "uz-Cyrl" / "ru".
enum Language {
  uz_Latn
  uz_Cyrl
  ru
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?
  /// null until the user picks "I need a master" / "I am a master".
  role      UserRole?
  language  Language?
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  requests        Request[]      @relation("CustomerRequests")
  masterProfile   MasterProfile?
  offers          Offer[]        @relation("MasterOffers")
  pushTokens      PushToken[]
  customerJobs    Job[]          @relation("CustomerJobs")
  masterJobs      Job[]          @relation("MasterJobs")
  reviewsGiven    Review[]       @relation("ReviewsGiven")
  reviewsReceived Review[]       @relation("ReviewsReceived")
  complaintsSent  Complaint[]    @relation("ComplaintsSent")
  chatMessages    ChatMessage[]  @relation("ChatMessagesSent")
  callsMade       Call[]         @relation("CallsMade")
  callsReceived   Call[]         @relation("CallsReceived")
}

// ---------- Catalog (M2) ----------
// Names are stored in three columns (one per app language).

/// 12 regions + Tashkent city + Karakalpakstan.
model Region {
  id         String  @id @default(cuid())
  slug       String  @unique
  nameUzLatn String
  nameUzCyrl String
  nameRu     String
  /// true once we have launched there (masters onboarded).
  isActive   Boolean @default(false)
  sortOrder  Int     @default(0)

  districts      District[]
  priceOverrides RegionPrice[]
  waitlist       WaitlistEntry[]
}

enum DistrictType {
  DISTRICT
  CITY
}

/// Districts (tumanlar) and district-level cities (shaharlar).
model District {
  id         String       @id @default(cuid())
  slug       String       @unique
  regionId   String
  region     Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  type       DistrictType @default(DISTRICT)
  nameUzLatn String
  nameUzCyrl String
  nameRu     String
  /// Approximate center. null when not known yet.
  lat        Float?
  lng        Float?
  sortOrder  Int          @default(0)

  waitlist WaitlistEntry[]
  requests Request[]
  masters  MasterProfile[]

  @@index([regionId])
}

/// A group of trades on the "All services" screen ("Repair", "Appliances", ...).
/// Managed from the admin panel.
model CategoryGroup {
  id         String     @id @default(cuid())
  slug       String     @unique
  nameUzLatn String
  nameUzCyrl String
  nameRu     String
  sortOrder  Int        @default(0)
  categories Category[]
}

model Category {
  id         String         @id @default(cuid())
  slug       String         @unique
  nameUzLatn String
  nameUzCyrl String
  nameRu     String
  /// Lucide icon name from CATEGORY_ICONS in @usta/shared.
  icon       String
  /// Tile color from CATEGORY_COLORS in @usta/shared.
  color      String         @default("gray")
  groupId    String?
  group      CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)

  priceItems PriceItem[]
  waitlist   WaitlistEntry[]
  requests   Request[]
  masters    MasterProfile[]
}

/// A typical job with a published price range, e.g. "Replace a faucet: 80 000–150 000".
model PriceItem {
  id         String   @id @default(cuid())
  slug       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameUzLatn String
  nameUzCyrl String
  nameRu     String
  /// Prices in so'm.
  minPrice   Int
  maxPrice   Int
  sortOrder  Int      @default(0)

  regionOverrides RegionPrice[]

  @@index([categoryId])
}

/// Optional different price range for one region (prices in Tashkent differ from Khorezm).
model RegionPrice {
  id          String    @id @default(cuid())
  priceItemId String
  priceItem   PriceItem @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
  regionId    String
  region      Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  minPrice    Int
  maxPrice    Int

  @@unique([priceItemId, regionId])
}

/// Customers who want a service where we have no masters yet. Used as demand data.
model WaitlistEntry {
  id         String    @id @default(cuid())
  phone      String
  regionId   String
  region     Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([regionId])
}

// ---------- Requests (M3) ----------

enum DesiredTime {
  NOW
  TODAY
  SCHEDULED
}

enum RequestStatus {
  OPEN
  ASSIGNED
  CANCELLED
  EXPIRED
}

/// A customer's repair request ("my faucet is leaking").
model Request {
  id          String        @id @default(cuid())
  customerId  String
  customer    User          @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  description String?
  /// Storage keys (not URLs): download links are created on demand.
  photoKeys   String[]
  voiceKey    String?
  districtId  String
  district    District      @relation(fields: [districtId], references: [id])
  address     String
  landmark    String?
  lat         Float?
  lng         Float?
  desiredTime DesiredTime
  scheduledAt DateTime?
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  /// OPEN requests become EXPIRED after 24 h without a chosen master.
  expiresAt   DateTime

  offers Offer[]
  job    Job?

  @@index([customerId, status])
  @@index([status, districtId, categoryId])
}

// ---------- Master side (M4) ----------

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Extra data for users who work as masters.
model MasterProfile {
  userId             String             @id
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoKey           String?
  bio                String?
  workPhotoKeys      String[]
  /// Only VERIFIED masters see requests (an admin checks passport and work samples).
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  /// "I'm accepting orders" switch.
  isAvailable        Boolean            @default(true)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  completedJobsCount Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  categories Category[]
  districts  District[]
}

enum OfferStatus {
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// A master's price and arrival time for a request.
model Offer {
  id        String      @id @default(cuid())
  requestId String
  request   Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  masterId  String
  master    User        @relation("MasterOffers", fields: [masterId], references: [id], onDelete: Cascade)
  /// So'm.
  price     Int
  /// When the master can be at the address.
  arrivalAt DateTime
  message   String?
  status    OfferStatus @default(SENT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  job       Job?

  /// One offer per master per request.
  @@unique([requestId, masterId])
  @@index([masterId, status])
}

// ---------- Jobs (M5) ----------

enum JobStatus {
  ACCEPTED
  ON_THE_WAY
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Work agreed between a customer and the chosen master.
model Job {
  id                 String    @id @default(cuid())
  requestId          String    @unique
  request            Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offerId            String    @unique
  offer              Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User      @relation("CustomerJobs", fields: [customerId], references: [id], onDelete: Cascade)
  masterId           String
  master             User      @relation("MasterJobs", fields: [masterId], references: [id], onDelete: Cascade)
  /// Price from the accepted offer (so'm).
  agreedPrice        Int
  /// Changes ONLY through an APPROVED PriceChange; set to the current price when DONE.
  finalPrice         Int?
  status             JobStatus @default(ACCEPTED)
  /// "On the way, ~20 min".
  onTheWayEtaMinutes Int?
  acceptedAt         DateTime  @default(now())
  onTheWayAt         DateTime?
  startedAt          DateTime?
  doneAt             DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelReason       String?
  /// Free return visit if the problem comes back before this date (default 14 days).
  guaranteeUntil     DateTime?

  priceChanges    PriceChange[]
  review          Review?
  guaranteeClaims GuaranteeClaim[]
  complaints      Complaint[]
  messages        ChatMessage[]
  calls           Call[]

  @@index([customerId, status])
  @@index([masterId, status])
}

enum PriceChangeStatus {
  PENDING
  APPROVED
  DECLINED
}

/// "You need extra parts": the master proposes a new price, the customer must approve it.
model PriceChange {
  id         String            @id @default(cuid())
  jobId      String
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  newPrice   Int
  reason     String
  status     PriceChangeStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  answeredAt DateTime?

  @@index([jobId, status])
}

// ---------- Trust (M6) ----------

/// Only the customer of a DONE job can review it, and only once (jobId is unique).
model Review {
  id         String   @id @default(cuid())
  jobId      String   @unique
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("ReviewsGiven", fields: [customerId], references: [id], onDelete: Cascade)
  masterId   String
  master     User     @relation("ReviewsReceived", fields: [masterId], references: [id], onDelete: Cascade)
  /// 1–5.
  stars      Int
  comment    String?
  photoKeys  String[]
  /// REVIEW_TAGS from @usta/shared ("on time", "clean", ...).
  tags       String[] @default([])
  createdAt  DateTime @default(now())

  @@index([masterId, createdAt])
}

enum ClaimStatus {
  OPEN
  RESOLVED
  REJECTED
}

/// "The problem came back": a free return visit within the guarantee period.
model GuaranteeClaim {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  description String
  status      ClaimStatus @default(OPEN)
  adminNote   String?
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?

  @@index([jobId])
  @@index([status, createdAt])
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

/// A complaint about a job, from either side. Handled by an admin.
model Complaint {
  id         String          @id @default(cuid())
  jobId      String
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User            @relation("ComplaintsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  /// COMPLAINT_REASONS from @usta/shared; null for complaints sent before reasons existed.
  reason     String?
  text       String
  photoKeys  String[]        @default([])
  voiceKey   String?
  status     ComplaintStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([jobId])
}

enum ChatMessageType {
  TEXT
  PHOTO
  VOICE
  /// Written by the app ("Price approved: 120 000"). text = event code, params = JSON values.
  SYSTEM
}

/// Chat between the customer and the master of one job.
model ChatMessage {
  id         String          @id @default(cuid())
  /// Strict order of messages (several can share the same createdAt).
  seq        Int             @unique @default(autoincrement())
  jobId      String
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// null for SYSTEM messages.
  senderId   String?
  sender     User?           @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: SetNull)
  type       ChatMessageType
  text       String?
  /// Storage key of a photo or voice message.
  mediaKey   String?
  /// Voice length in milliseconds.
  durationMs Int?
  /// SYSTEM only: values for the event text, e.g. {"price":"120000"}.
  params     Json?
  createdAt  DateTime        @default(now())

  @@index([jobId, seq])
}

enum CallStatus {
  RINGING
  ANSWERED
  DECLINED
  MISSED
  ENDED
}

/// In-app voice call between the two sides of a job (LiveKit). Audio is never recorded.
model Call {
  id         String     @id @default(cuid())
  jobId      String
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  callerId   String
  caller     User       @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId   String
  callee     User       @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  status     CallStatus @default(RINGING)
  createdAt  DateTime   @default(now())
  answeredAt DateTime?
  endedAt    DateTime?

  @@index([jobId, createdAt])
  @@index([calleeId, status])
}

/// Admin panel accounts. Separate from app users: they log in with a password, not SMS.
model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  /// scrypt hash, never the password itself.
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

/// Expo push token of a phone (one user can have several phones).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// One-time login codes. We store a hash, never the code itself.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// Long-lived login sessions. We store a hash of the token, never the token itself.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
